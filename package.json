{
  "name": "inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:test": "node scripts/db-test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "test:all": "pnpm test && pnpm test:integration && pnpm db:test",
    "seed": "node --env-file=.env.local --import tsx scripts/seed.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.6"
  }
}
