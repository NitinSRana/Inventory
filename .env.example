# Copy to .env.local and fill in. Never commit .env.local.

# Application connection. Must be a NOBYPASSRLS role — see
# supabase/migrations/0002_app_runtime_role.sql. Supabase's own `postgres` role
# has BYPASSRLS and would silently disable every policy.
DATABASE_URL=postgresql://app_runtime:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Owner connection. Used by pnpm db:migrate and manual org creation only —
# never in app code, because this role has BYPASSRLS.
ADMIN_DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth. Local `supabase start` prints both of these on startup.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. pnpm db:test starts its own throwaway Postgres, so this is only
# needed to run against an existing server. Never point it at Supabase.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# service_role bypasses RLS. Migrations and trusted jobs only — never in
# request-handling code. Leave unset unless a job actually needs it.
# SUPABASE_SERVICE_ROLE_KEY=

# Outgoing mail, for invitations. Both are needed or nothing is sent — the app
# says so on the Team screen rather than pretending a message went out. MAIL_FROM
# must be on a domain verified with the provider, or every send is rejected.
# RESEND_API_KEY=
# MAIL_FROM=Shop Name <inventory@yourdomain.example>

# Absolute origin used in emailed links. Falls back to the request's own origin,
# so it only matters where that is wrong — behind a proxy, or in a job.
# NEXT_PUBLIC_SITE_URL=https://inventory.example.com
