# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection used by Drizzle. Supabase: the *transaction pooler* URI
# (port 6543), which is why src/db/tenant.ts sets prepare: false.
# Local `supabase start` default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth. Local `supabase start` prints both of these on startup.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role bypasses RLS. Migrations and trusted jobs only — never in
# request-handling code. Leave unset unless a job actually needs it.
# SUPABASE_SERVICE_ROLE_KEY=
